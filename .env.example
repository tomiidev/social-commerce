PORT=5000
MONGODB_URI=mongodb://localhost:27017/socialflow
JWT_SECRET=socialflow_secret_key_123456_change_me
GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=development
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Meta (Facebook / Instagram) — Graph API v26.0
# Crear app en https://developers.facebook.com/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_custom_random_verify_token
META_API_VERSION=v26.0
# URL de callback OAuth (debe estar aprobada en el Meta App Dashboard)
META_REDIRECT_URI=http://localhost:5000/api/meta/auth/callback
# URL del frontend para redirigir luego del OAuth
FRONTEND_URL=http://localhost:3000
